<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Title>SyntaxParser</Title>
		<Authors>Natvs</Authors>
		<AssemblyName>Nt.SyntaxParser</AssemblyName>
		<RootNamespace>Nt.Syntax</RootNamespace>	  
		<Version>1.3.0</Version>
		<Description>Library containing tools for parsing grammars and interpreting custom syntaxes.</Description>
		
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Natvs/Nt.SyntaxParser</RepositoryUrl>

		<PackageId>Nt.SyntaxParser</PackageId>
		<PackageVersion>1.3.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>parser ; grammar ; syntax</PackageTags>
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText('$([MSBuild]::GetPathOfFileAbove(release-notes.md))'))</PackageReleaseNotes>
		<PackageLocalOnly>false</PackageLocalOnly>
	  
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="bin\**" />
		<None Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Visible>false</Visible>
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>  
		<None Include="..\Doc\**">
			<Link>Doc\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<Visible>false</Visible>
			<Pack>True</Pack>
			<PackagePath>Doc\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Nt.Parser" Version="1.0.5" />
		<PackageReference Include="Nt.Automaton" Version="1.3.1" />
	</ItemGroup>

</Project>
