<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
	    <OutputType>Library</OutputType>
		
        <Title>Nt.SyntaxParser</Title>
        <RootNamespace>Nt.Syntax</RootNamespace>
		<Description>Library containing tools for syntax parsing.</Description>   
		<Version>1.2.0</Version>
		<ReleaseNotes>Add string exportation methods for grammar with 3 different modes.</ReleaseNotes>
        
		<RepositoryUrl>https://github.com/Natvs/Nt.SyntaxParser</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
		
		<PackageId>Nt.SyntaxParser</PackageId>
		<PackageVersion>1.2.0</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>        
		<PackageTags>parser ; grammar ; syntax</PackageTags>
        <PackageReleaseNotes>Add string exportation methods for grammar with 3 different modes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nt.Automaton" Version="1.1.0" />
    <PackageReference Include="Nt.Parser" Version="1.0.3" />
  </ItemGroup>

</Project>
